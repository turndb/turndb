{
  "name": "turndb",
  "version": "0.2.1",
  "description": "A content-addressed columnar store for AI traces: byte-exact, embedded, and readable by the CLI and the Rust crate over the same file.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./index.mjs",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.mjs"
    },
    "./memory": {
      "types": "./memory.d.ts",
      "default": "./memory.mjs"
    },
    "./turndb.wasm": "./turndb.wasm"
  },
  "files": [
    "index.mjs",
    "index.d.ts",
    "core.mjs",
    "memory.mjs",
    "memory.d.ts",
    "wasi-memfs.mjs",
    "turndb.wasm",
    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "engines": {
    "node": ">=22 <27"
  },
  "keywords": [
    "storage",
    "content-addressed",
    "traces",
    "llm",
    "observability",
    "wasm"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/turndb/turndb.git"
  },
  "scripts": {
    "test": "node --test test/*.mjs",
    "prepublishOnly": "bash ../prepublish-check.sh && bash ../build.sh"
  }
}