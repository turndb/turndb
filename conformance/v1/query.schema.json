{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://turndb.dev/conformance/v1/query.schema.json",
  "title": "TurnDB structured query contract v1",
  "oneOf": [
    { "$ref": "#/$defs/request" },
    { "$ref": "#/$defs/result" },
    { "$ref": "#/$defs/corpus" }
  ],
  "$defs": {
    "decimalI64": {
      "type": "string",
      "pattern": "^(0|-[1-9][0-9]*|[1-9][0-9]*)$"
    },
    "decimalU64": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$"
    },
    "positiveDecimalU64": {
      "type": "string",
      "pattern": "^[1-9][0-9]*$"
    },
    "scalar": {
      "oneOf": [
        {
          "type": "object",
          "required": ["type", "value"],
          "properties": { "type": { "const": "string" }, "value": { "type": "string" } },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["type", "decimal"],
          "properties": { "type": { "const": "i64" }, "decimal": { "$ref": "#/$defs/decimalI64" } },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["type", "bitsHex"],
          "properties": { "type": { "const": "f64" }, "bitsHex": { "type": "string", "pattern": "^[0-9a-f]{16}$" } },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["type", "value"],
          "properties": { "type": { "const": "bool" }, "value": { "type": "boolean" } },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["type", "decimal"],
          "properties": { "type": { "const": "u64" }, "decimal": { "$ref": "#/$defs/decimalU64" } },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["type", "base64"],
          "properties": { "type": { "const": "binary" }, "base64": { "type": "string", "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$" } },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["type", "decimal"],
          "properties": { "type": { "const": "timestampNs" }, "decimal": { "$ref": "#/$defs/decimalI64" } },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["type"],
          "properties": { "type": { "const": "null" } },
          "additionalProperties": false
        }
      ]
    },
    "attribute": {
      "type": "object",
      "required": ["name", "value"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "value": { "$ref": "#/$defs/scalar" }
      },
      "additionalProperties": false
    },
    "inputContent": {
      "type": "object",
      "required": ["name", "base64"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "base64": { "type": "string", "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$" },
        "storage": { "type": "string", "enum": ["literal", "piece"] }
      },
      "additionalProperties": false
    },
    "inputRecord": {
      "type": "object",
      "required": ["id", "attrs", "contents"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "attrs": { "type": "array", "items": { "$ref": "#/$defs/attribute" } },
        "contents": { "type": "array", "items": { "$ref": "#/$defs/inputContent" } }
      },
      "additionalProperties": false
    },
    "compare": { "type": "string", "enum": ["eq", "ne", "lt", "lte", "gt", "gte"] },
    "predicate": {
      "oneOf": [
        {
          "type": "object",
          "required": ["kind", "op", "value"],
          "properties": { "kind": { "const": "id" }, "op": { "$ref": "#/$defs/compare" }, "value": { "type": "string" } },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind", "name", "op", "value"],
          "properties": { "kind": { "const": "attr" }, "name": { "type": "string", "minLength": 1 }, "op": { "$ref": "#/$defs/compare" }, "value": { "$ref": "#/$defs/scalar" } },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind", "name", "present"],
          "properties": { "kind": { "const": "attrExists" }, "name": { "type": "string", "minLength": 1 }, "present": { "type": "boolean" } },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind", "name", "present"],
          "properties": { "kind": { "const": "contentExists" }, "name": { "type": "string", "minLength": 1 }, "present": { "type": "boolean" } },
          "additionalProperties": false
        }
      ]
    },
    "contentSelect": {
      "type": "object",
      "required": ["name", "mode"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "mode": { "type": "string", "enum": ["metadata", "bytes"] }
      },
      "additionalProperties": false
    },
    "request": {
      "type": "object",
      "required": ["contractVersion"],
      "properties": {
        "contractVersion": { "const": 1 },
        "from": { "type": "string" },
        "to": { "type": "string" },
        "direction": { "type": "string", "enum": ["forward", "reverse"] },
        "cursor": { "type": "string" },
        "limit": { "type": "integer", "minimum": 1, "maximum": 10000 },
        "maxExamined": { "type": "integer", "minimum": 1, "maximum": 1000000 },
        "maxResolutionEntries": { "type": "integer", "minimum": 1, "maximum": 10000000 },
        "maxReconstructedBytes": { "$ref": "#/$defs/positiveDecimalU64" },
        "attrs": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "contents": { "type": "array", "items": { "$ref": "#/$defs/contentSelect" } },
        "predicates": { "type": "array", "items": { "$ref": "#/$defs/predicate" } }
      },
      "additionalProperties": false
    },
    "projectedContent": {
      "type": "object",
      "required": ["name", "present"],
      "properties": {
        "name": { "type": "string" },
        "present": { "type": "boolean" },
        "len": { "$ref": "#/$defs/decimalU64" },
        "pieces": { "$ref": "#/$defs/decimalU64" },
        "identityHex": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "base64": { "type": "string", "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$" }
      },
      "additionalProperties": false
    },
    "row": {
      "type": "object",
      "required": ["id", "attrs", "contents"],
      "properties": {
        "id": { "type": "string" },
        "attrs": { "type": "array", "items": { "$ref": "#/$defs/attribute" } },
        "contents": { "type": "array", "items": { "$ref": "#/$defs/projectedContent" } }
      },
      "additionalProperties": false
    },
    "stats": {
      "type": "object",
      "required": ["examined", "returned", "predicatePrunedRows", "duplicateAttrOccurrences", "contentValuesReconstructed", "reconstructedBytes"],
      "properties": {
        "examined": { "$ref": "#/$defs/decimalU64" },
        "returned": { "$ref": "#/$defs/decimalU64" },
        "predicatePrunedRows": { "$ref": "#/$defs/decimalU64" },
        "duplicateAttrOccurrences": { "$ref": "#/$defs/decimalU64" },
        "contentValuesReconstructed": { "$ref": "#/$defs/decimalU64" },
        "reconstructedBytes": { "$ref": "#/$defs/decimalU64" }
      },
      "additionalProperties": true
    },
    "result": {
      "type": "object",
      "required": ["contractVersion", "rows", "stats"],
      "properties": {
        "contractVersion": { "const": 1 },
        "rows": { "type": "array", "items": { "$ref": "#/$defs/row" } },
        "next": { "type": "string" },
        "stats": { "$ref": "#/$defs/stats" }
      },
      "additionalProperties": false
    },
    "step": {
      "oneOf": [
        {
          "type": "object",
          "required": ["action", "name", "puts", "deletes"],
          "properties": {
            "action": { "const": "apply" },
            "name": { "type": "string", "minLength": 1 },
            "puts": { "type": "array", "items": { "$ref": "#/$defs/inputRecord" } },
            "deletes": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["action"],
          "properties": { "action": { "enum": ["sync", "flush"] } },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["action", "name"],
          "properties": { "action": { "enum": ["captureSnapshot", "assertWriter"] }, "name": { "type": "string", "minLength": 1 } },
          "additionalProperties": false
        }
      ]
    },
    "view": {
      "type": "object",
      "required": ["name", "source", "records"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "source": { "type": "string", "minLength": 1 },
        "records": { "type": "array", "items": { "$ref": "#/$defs/inputRecord" } }
      },
      "additionalProperties": false
    },
    "queryCase": {
      "type": "object",
      "required": ["name", "source", "request", "expectedIds"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "source": { "type": "string", "minLength": 1 },
        "request": { "$ref": "#/$defs/request" },
        "paginate": { "type": "boolean" },
        "expectedIds": { "type": "array", "items": { "type": "string" } },
        "assertMetadataOnlyIo": { "type": "boolean" },
        "assertCursorDamageRejected": { "type": "boolean" },
        "assertCursorMismatchRejected": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "corpus": {
      "type": "object",
      "required": ["contractVersion", "steps", "views", "queries"],
      "properties": {
        "contractVersion": { "const": 1 },
        "steps": { "type": "array", "items": { "$ref": "#/$defs/step" } },
        "views": { "type": "array", "items": { "$ref": "#/$defs/view" } },
        "queries": { "type": "array", "items": { "$ref": "#/$defs/queryCase" } }
      },
      "additionalProperties": false
    }
  }
}
